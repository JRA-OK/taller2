@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

<form asp-action="Index" method="post" class="formulario">
    @* "Usuario o clave incorrectos" es un error del modelo (sin campo): se muestra en el resumen *@
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <label asp-for="NombreUsuario"></label>
    <input asp-for="NombreUsuario" autocomplete="username" autofocus />
    <span asp-validation-for="NombreUsuario"></span>

    <label asp-for="Clave"></label>
    <input asp-for="Clave" autocomplete="current-password" />
    <span asp-validation-for="Clave"></span>

    <button type="submit">Ingresar</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
