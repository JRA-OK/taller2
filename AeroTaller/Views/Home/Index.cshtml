@model List<VueloOcupacionViewModel>
@{
    ViewData["Title"] = "Próximas salidas";
}

<h1>Próximas salidas</h1>

@if (Model.Count == 0)
{
    <p class="nota">No hay vuelos programados.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Vuelo</th><th>Ruta</th><th>Salida</th><th>Ocupación</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var fila in Model)
            {
                <tr>
                    <td>@fila.Vuelo.Numero</td>
                    <td>@fila.Vuelo.Origen.Codigo → @fila.Vuelo.Destino.Codigo</td>
                    <td>@fila.Vuelo.Salida.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="barra"><span style="width: @fila.Porcentaje%"></span></span>
                        @fila.Ocupados / @fila.Vuelo.Capacidad
                    </td>
                    <td><a asp-controller="Vuelos" asp-action="Detalle" asp-route-id="@fila.Vuelo.Id">Ver asientos</a></td>
                </tr>
            }
        </tbody>
    </table>
}
