@inject IConfiguration Configuracion
@inject IAutenticacionService Autenticacion
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Cada vista define su título en ViewData["Title"] *@
    <title>@ViewData["Title"] · AeroTaller</title>
    <link rel="stylesheet" href="~/css/sitio.css" asp-append-version="true" />
</head>
<body>
    @if (Configuracion["OrigenDeDatos"] == "Falso")
    {
        <div class="aviso-falso">Modo de prueba: datos en memoria (OrigenDeDatos = Falso). Los cambios se pierden al reiniciar.</div>
    }
    <header>
        <a class="marca" asp-controller="Home" asp-action="Index">AeroTaller</a>
        <nav>
            <a asp-controller="Vuelos" asp-action="Index">Vuelos</a>
            @* Ocultar un link es comodidad, no seguridad: la protección real la ponen los filtros en el controlador *@
            @if (Autenticacion.EstaAutenticado)
            {
                <a asp-controller="Reservas" asp-action="Index">Reservas</a>
                <a asp-controller="Pasajeros" asp-action="Index">Pasajeros</a>
            }
        </nav>
        <div class="usuario">
            @if (Autenticacion.EstaAutenticado)
            {
                <span>@Autenticacion.Nombre (@Autenticacion.Rol)</span>
                <form asp-controller="Login" asp-action="Salir" method="post">
                    <button type="submit" class="enlace">Salir</button>
                </form>
            }
            else
            {
                <a asp-controller="Login" asp-action="Index">Iniciar sesión</a>
            }
        </div>
    </header>

    <main>
        @* Mensaje de una sola lectura que deja un POST exitoso antes del Redirect (patrón PRG) *@
        @if (TempData["Mensaje"] is string mensaje)
        {
            <p class="mensaje ok">@mensaje</p>
        }
        @if (TempData["Error"] is string error)
        {
            <p class="mensaje error">@error</p>
        }

        @* Aquí se dibuja la vista que eligió el controlador *@
        @RenderBody()
    </main>

    <footer>
        AeroTaller · TP integrador de Taller de Lenguajes 2 · FACET · @DateTime.Now.Year
    </footer>

    @* Scripts propios de cada vista; si una vista no los define, la sección se omite sin error *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
