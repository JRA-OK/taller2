  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- El script viaja junto al .dll: CrearBaseSiNoExiste lo lee desde AppContext.BaseDirectory -->
